# Template: Node / TypeScript + esbuild single-file bundle + distroless
# Expected final size: 60-110 MB
# Use when:
#   - The app can be bundled but Tier 0 (bun-compile-to-scratch) failed —
#     e.g., a `--external` native module needs to load at runtime, or bun
#     bytecode emit broke on the codebase.
#   - You ran `scripts/audit-node-bundle.sh` and it recommended Tier 1.
#
# Substitute:
#   <ENTRY>          — entry source, e.g., src/main.ts
#   <NODE_VERSION>   — pinned node minor, e.g., 20.18
#   <EXPOSE_PORT>    — port the server listens on
#
# Notes:
#   - Bundle is a single JS file. node_modules is NOT shipped to runtime —
#     only the bundle plus any audit-flagged externals (copied surgically
#     from the install tree, not via a blanket `pnpm deploy`).
#   - Add a COPY for each `--external` package noted by the audit, e.g.:
#       COPY --from=build /src/node_modules/sharp /app/node_modules/sharp

# syntax=docker/dockerfile:1.7

# ---- Stage 1: bundle (glibc, full toolchain) ----
FROM node:<NODE_VERSION>-bookworm-slim AS build
WORKDIR /src
ENV NODE_ENV=production NPM_CONFIG_FUND=false NPM_CONFIG_AUDIT=false

COPY package.json package-lock.json* pnpm-lock.yaml* yarn.lock* ./
# Use whichever lockfile is present. Audit will tell you which manager.
RUN --mount=type=cache,target=/root/.npm \
    if [ -f pnpm-lock.yaml ]; then \
      corepack enable && pnpm install --frozen-lockfile; \
    elif [ -f yarn.lock ]; then \
      corepack enable && yarn install --frozen-lockfile; \
    else \
      npm ci; \
    fi

COPY . .

# Single-file bundle. Pass --external <pkg> for each audit-flagged native
# binding. esbuild minifies + tree-shakes; the resulting file is the only
# thing the runtime needs to load.
RUN npx --yes esbuild <ENTRY> \
      --bundle \
      --platform=node \
      --target=node20 \
      --format=cjs \
      --minify \
      --legal-comments=none \
      --sourcemap=external \
      --outfile=/out/server.js

# ---- Stage 2: distroless runtime ----
FROM gcr.io/distroless/nodejs20-debian12:nonroot
WORKDIR /app
COPY --from=build /out/server.js ./server.js

# Per-external native module COPYs go here, one line each:
# COPY --from=build /src/node_modules/sharp        ./node_modules/sharp
# COPY --from=build /src/node_modules/better-sqlite3 ./node_modules/better-sqlite3

EXPOSE <EXPOSE_PORT>
CMD ["server.js"]
